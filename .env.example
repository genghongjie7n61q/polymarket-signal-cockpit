# Local development defaults for docker-compose.
# Copy this file to .env and replace passwords/webhooks before using a shared host.

POLY_ENV=local
RUST_LOG=info
APP_VERSION=0.1.0-dev
APP_HOST=0.0.0.0
APP_PORT=8080
BACKEND_BIND=127.0.0.1
SUPPORTED_MARKETS=btc5m,eth15m
STORAGE_WRITER_QUEUE_CAPACITY=4096
STORAGE_WRITER_FLUSH_INTERVAL_MS=250

POSTGRES_USER=polymarket
POSTGRES_PASSWORD=replace-with-a-local-random-password
POSTGRES_DB=polymarket
DATABASE_URL=postgres://polymarket:replace-with-a-local-random-password@postgres:5432/polymarket

# Optional in WEB-5. Real webhook values must stay in .env only.
FEISHU_WEBHOOK_URL=
